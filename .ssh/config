AddKeysToAgent yes
EnableSSHKeysign yes
HashKnownHosts yes
ServerAliveCountMax 3
ServerAliveInterval 60

Host github.com
    HostName github.com
    IdentityFile ~/.ssh/id_GitHub
    IdentitiesOnly yes

Host course-gitlab.tuni.fi
    HostName course-gitlab.tuni.fi
    IdentityFile ~/.ssh/id_Course_GitLab
    IdentitiesOnly yes

